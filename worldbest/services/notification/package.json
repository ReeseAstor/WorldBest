    "express-validator": "^7.0.1",
    "bull": "^4.12.2",
    "redis": "^4.6.10",
    "nodemailer": "^7.0.10",
    "@sendgrid/mail": "^8.1.0",
    "twilio": "^4.19.3",
    "web-push": "^3.6.6",
    "handlebars": "^4.7.8",
    "juice": "^10.0.0",
    "axios": "^1.6.2",
    "zod": "^3.22.4",
    "@worldbest/shared-types": "workspace:*",
