    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "bull": "^4.12.2",
    "puppeteer": "^21.6.1",
    "epub-gen": "^0.1.0",
    "docx": "^8.5.0",
    "jspdf": "^2.5.1",
    "html-pdf": "^3.0.1",
    "minio": "^7.1.3",
    "amqplib": "^0.10.3",
    "redis": "^4.6.10",
    "@worldbest/shared-types": "workspace:*",
